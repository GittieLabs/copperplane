# macOS Finder metadata
.DS_Store

# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# PyInstaller (SPEC-401/CTX-401.1): daemon.spec's own real build output --
# a machine/platform-specific frozen binary, never a repo artifact.
services/python-daemon/build/

# Tauri/Rust
src-tauri/target/

# Node
node_modules/
dist/

# PyInstaller (SPEC-401/CTX-401.2): re-include the two placeholder sidecar
# binaries tauri-build's own build.rs requires to exist on every `cargo
# build`/`cargo test` invocation. These negations MUST come after the
# blanket `dist/` rule above -- gitignore is last-match-wins, so placing
# them earlier (as an initial attempt here did) has no effect: the later
# `dist/` rule still re-excludes the directory. The three-step shape --
# un-ignore the directory, wildcard-ignore its contents, then re-include
# specific files -- is git's own documented pattern; a bare directory
# negation alone does not un-ignore files under an already-excluded parent.
!services/python-daemon/dist/
services/python-daemon/dist/*
!services/python-daemon/dist/hardware-agent-studio-daemon-aarch64-apple-darwin
!services/python-daemon/dist/hardware-agent-studio-daemon-x86_64-apple-darwin
!services/python-daemon/dist/hardware-agent-studio-daemon-x86_64-pc-windows-msvc.exe
!services/python-daemon/dist/hardware-agent-studio-daemon-x86_64-unknown-linux-gnu

# Claude Code machine-local permission state — not shared config
.claude/settings.local.json

# Local secrets (SPEC-201 provider API keys, etc.) — never committed
.env.local
.env*.local

# Real Apple/App Store Connect signing credentials (SPEC-402) -- private
# key material that must only ever live in GitHub Actions secrets, never
# in the repo itself, not even briefly.
developer-key/
*.p8
*.p12

# KiCad-generated local settings sidecar (CTX-309.1): kicad-cli itself
# writes this next to any .kicad_pcb it processes -- machine/session-
# specific UI state, not part of the real fixture content, regenerated
# identically on every run.
*.kicad_prl
# Raw screen captures. Reviewed, redacted with scripts/redact_screenshots.py,
# then cropped into docs/site/public/images/ -- the originals are never committed.
screenshots/
Walkthrough-Copperplane/
