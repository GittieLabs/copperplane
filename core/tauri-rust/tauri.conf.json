{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Copperplane",
  "version": "0.4.0",
  "identifier": "com.gittielabs.hardware-agent-studio",
  "build": {
    "frontendDist": "../../apps/tauri-ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev --prefix ../apps/tauri-ui",
    "beforeBuildCommand": "python3 ../services/python-daemon/scripts/ensure_sidecar.py && npm run build --prefix ../apps/tauri-ui"
  },
  "app": {
    "windows": [
      {
        "title": "Copperplane",
        "width": 1280,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/generated/**"
        ]
      }
    }
  },
  "plugins": {
    "shell": {
      "open": "^(https?://.+|/.+|[A-Za-z]:[\\\\/].+)$"
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/GittieLabs/copperplane/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzQUFGMkY0Q0I4OEU0NjIKUldSaTVJakw5UEtxTThtZXFoaXBuK2ZCMnpJY2FiakR0LzN6NGdGZnZaK1VmVWdRTVE0dzVMSjgK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  }
}
